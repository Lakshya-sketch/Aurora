# Aurora v2 — Environment Variables
# =================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit real secrets.
#
# The agent reads these at startup. Anything in `config/aurora.yaml`
# can reference these via ${VAR_NAME} syntax (handled by config.py).

# ---- Core paths ----
# Project root. Default works on a standard install.
AURORA_HOME=E:/NeuralChat2

# Where runtime data lives (DB, logs, vector store, inbox).
# Relative paths resolve under AURORA_HOME.
AURORA_DATA_DIR=${AURORA_HOME}/data
AURORA_LOG_DIR=${AURORA_HOME}/data
AURORA_DB_PATH=${AURORA_DATA_DIR}/aurora.db
AURORA_CHROMA_DIR=${AURORA_DATA_DIR}/chroma
AURORA_INBOX_DIR=${AURORA_DATA_DIR}/inbox

# ---- LLM (Ollama) ----
# Local Ollama HTTP API. Do NOT change unless pointing to a remote box.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_VLM_MODEL=llava
OLLAMA_TIMEOUT_S=120

# ---- Embeddings ----
# sentence-transformers model identifier. Auto-downloads on first run.
AURORA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
AURORA_EMBED_DEVICE=cpu

# ---- Backend (Quart) ----
AURORA_HOST=127.0.0.1
AURORA_PORT=8765
AURORA_LOG_LEVEL=INFO

# ---- Electron UI ----
# Tells the renderer where to connect.
AURORA_WS_URL=ws://127.0.0.1:8765/stream
AURORA_HTTP_URL=http://127.0.0.1:8765

# ---- Plugins (enable/disable, override defaults from aurora.yaml) ----
# Comma-separated. Empty = use config defaults.
AURORA_PLUGINS_ENABLED=llm_ollama,rag_chroma,memory_sqlite,vision_easyocr,tools_builtin
AURORA_PLUGINS_DISABLED=

# ---- Security ----
# Random string used to sign WS handshakes. Optional but recommended.
AURORA_WS_SECRET=

# Optional: shared secret to gate tool execution requiring confirmation.
AURORA_TOOL_CONFIRM_TOKEN=

# ---- GitHub Tools (tools_builtin/github handler) ----
# Personal access token. Leave empty to disable GitHub tool.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# ---- Telemetry ----
# Aurora does not phone home. Leave OFF.
AURORA_TELEMETRY=off

# ---- Dev overrides ----
# Set to 1 to enable verbose plugin load logs.
AURORA_DEBUG_PLUGINS=0
